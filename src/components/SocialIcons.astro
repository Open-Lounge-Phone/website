---
// Header: Starlight's social icons (GitHub) plus a clear Donate button on every page.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { SPONSOR_URL } from "../consts.ts";
---

{SPONSOR_URL && (
  <a class="olp-donate" href={SPONSOR_URL} rel="noopener">♥ Donate</a>
)}
<Default {...Astro.props}><slot /></Default>

<style>
  .olp-donate {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.8rem;
    margin-inline-end: 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .olp-donate:hover {
    background: var(--sl-color-accent-high);
  }
</style>
